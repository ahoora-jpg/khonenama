{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khonenama",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "triggers": { "crons": ["*/2 * * * *"] },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khonenama-db",
      "database_id": "a991ffd9-0044-4821-8d69-3295ab6ea398",
      "migrations_dir": "db/migrations"
    }
  ],
  "keep_vars": true,
  "r2_buckets": [
    { "binding": "BUSINESS_MEDIA", "bucket_name": "khonenama-business-media" }
  ],
  "routes": [
    { "pattern": "www.khonenama.ir/*", "zone_name": "khonenama.ir" },
    { "pattern": "sms.khonenama.ir/*", "zone_name": "khonenama.ir" },
    { "pattern": "www.sms.khonenama.ir", "custom_domain": true }
  ],
  "vars": {
    "SMS_LIVE_SEND_ENABLED": "false",
    "RECOVERY_EMAIL_FROM": "noreply@khonenama.ir",
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/khonenama",
    "MEDIA_STORAGE_PROVIDER": "r2"
  }
}
