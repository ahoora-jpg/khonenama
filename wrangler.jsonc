{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khonenama",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/app-router-entry",
  "assets": {
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khonenama-db",
      "database_id": "a991ffd9-0044-4821-8d69-3295ab6ea398",
      "migrations_dir": "db/migrations"
    }
  ],
  "keep_vars": true,
  "vars": {
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/khonenama"
  }
}
