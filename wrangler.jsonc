{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "khonenama",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "worker.ts",
  "triggers": {
    "crons": [
      "*/2 * * * *"
    ]
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "khonenama-db",
      "database_id": "a991ffd9-0044-4821-8d69-3295ab6ea398",
      "migrations_dir": "db/migrations"
    }
  ],
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "BUSINESS_MEDIA",
      "bucket_name": "khonenama-business-media"
    },
    {
      "binding": "SMS_EVENT_ARCHIVE",
      "bucket_name": "khonenama-sms-events-private"
    }
  ],
  "routes": [
    {
      "pattern": "khonenama.ir",
      "custom_domain": true
    },
    {
      "pattern": "www.khonenama.ir/*",
      "zone_name": "khonenama.ir"
    },
    {
      "pattern": "sms.khonenama.ir/*",
      "zone_name": "khonenama.ir"
    },
    {
      "pattern": "www.sms.khonenama.ir",
      "custom_domain": true
    }
  ],
  "vars": {
    "SMS_LIVE_SEND_ENABLED": "true",
    "SMS_SIM_MODE": "default",
    "RECOVERY_EMAIL_FROM": "noreply@khonenama.ir",
    "IMAGEKIT_URL_ENDPOINT": "https://ik.imagekit.io/khonenama",
    "MEDIA_STORAGE_PROVIDER": "r2"
  },
  "queues": {
    "producers": [
      {
        "binding": "SMS_EVENTS",
        "queue": "khonenama-sms-events"
      },
      {
        "binding": "SMS_EVENTS_DLQ",
        "queue": "khonenama-sms-events-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "khonenama-sms-events",
        "max_batch_size": 20,
        "max_batch_timeout": 1,
        "max_concurrency": 2,
        "max_retries": 5,
        "dead_letter_queue": "khonenama-sms-events-dlq"
      }
    ]
  }
}
