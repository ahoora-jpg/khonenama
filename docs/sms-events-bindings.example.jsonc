// Review-only fragment. Merge after approval; this file is never used by deployment.
{
  "queues": {
    "producers": [
      { "binding": "SMS_EVENTS", "queue": "khonenama-sms-events" },
      { "binding": "SMS_EVENTS_DLQ", "queue": "khonenama-sms-events-dlq" }
    ],
    "consumers": [{
      "queue": "khonenama-sms-events",
      "max_batch_size": 20,
      "max_batch_timeout": 1,
      "max_concurrency": 2,
      "max_retries": 5,
      "dead_letter_queue": "khonenama-sms-events-dlq"
    }]
  },
  "r2_buckets": [{"binding":"SMS_EVENT_ARCHIVE","bucket_name":"khonenama-sms-events-private"}]
}
