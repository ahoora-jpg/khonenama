[Unit]
Description=Khonenama private payment relay
After=network-online.target
Wants=network-online.target
[Service]
User=khonenama-payment
Group=khonenama-payment
EnvironmentFile=/etc/khonenama-payment.env
ExecStart=/usr/bin/python3 /opt/khonenama-payment/relay.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
